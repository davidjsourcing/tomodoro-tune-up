{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(write_file|apply_diff|search_and_replace|insert_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "node .bob/hooks/test-after-write.mjs",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
